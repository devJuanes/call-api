{
    "name": "@devjuanes/matuclient",
    "version": "2.2.3",
    "description": "MatuDB Client - Self-hosted PostgreSQL database with real-time, auth, and storage. Built by DevJuanes (Juan Esteban Landazuri) from Cali, Colombia.",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "matudb",
        "matudb-client",
        "self-hosted-database",
        "local-database",
        "postgresql",
        "postgres-client",
        "realtime-database",
        "backend-as-a-service",
        "baas",
        "devjuanes",
        "cali-colombia",
        "colombian-developer",
        "database",
        "api",
        "rest",
        "websocket",
        "auth",
        "storage"
    ],
    "homepage": "https://devjuanes.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/DevJuanes/matu-db-api"
    },
    "bugs": {
        "url": "https://github.com/DevJuanes/matu-db-api/issues"
    },
    "author": {
        "name": "DevJuanes",
        "email": "contacto@devjuanes.com",
        "url": "https://devjuanes.com",
        "github": "https://github.com/DevJuanes"
    },
    "license": "MIT",
    "devDependencies": {
        "tsup": "^8.3.5",
        "typescript": "^5.7.2"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.98.0",
        "socket.io-client": "^4.8.3"
    }
}
