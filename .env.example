PORT=4100
NODE_ENV=development
CORS_ORIGIN=*

# MatuDB
MATUDB_URL=https://db.matudb.com
MATUDB_PROJECT_ID=your-project-id
MATUDB_API_KEY=mb_xxxx
MATUDB_USE_SUPABASE=false

# true = in-memory demo (no MatuDB)
MATUDB_DEMO=false

# TURN (coturn) — opcional pero recomendado
TURN_URLS=turn:TU_IP:3478,turns:TU_IP:5349
TURN_USERNAME=matucall
TURN_CREDENTIAL=cambia_esto

INVITE_BASE_URL=https://call.matubyte.com/join
